# Cloudflare Pages (mismas cabeceras que vercel.json). En Vercel este archivo no se usa.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/safety-worker.js
  Cache-Control: no-cache
/worker-basic.min.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
